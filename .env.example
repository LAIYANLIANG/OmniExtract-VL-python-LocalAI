# ==============================================================================
# OmniExtract-VL Environment Configuration Example
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000
OCR_SERVICE_PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omniextract_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_hex_string_in_production
JWT_REFRESH_SECRET=replace_with_another_secure_random_hex_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Local Vision-Language AI Service (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=adelnazmy2002/Qwen3-VL-4B-Instruct:Q4_K_M
ENABLE_QWEN_AUDIT=true
QWEN_CONFIDENCE_THRESHOLD=0.92

# Logging
LOG_LEVEL=info

